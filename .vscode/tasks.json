{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api: dev (checks, migrate, run)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/dev.ps1",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "api: dev with hot reload",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/dev.ps1 -Watch",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "api: check environment only",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/dev.ps1 -CheckOnly",
      "problemMatcher": []
    },
    {
      "label": "api: test",
      "type": "shell",
      "command": "dotnet test apps/api/BusinessOS.sln",
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
