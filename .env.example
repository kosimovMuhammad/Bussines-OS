# Production / CI reference: set these as environment variables (not a file the app reads).
# Local development uses `dotnet user-secrets` instead - see README.md and
# apps/api/WebApi/user-secrets.example.json. Nested keys use a double underscore.

ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Server=host;Port=5432;Database=db;User Id=user;Password=...;
CORS_ORIGIN=http://localhost:5173
# Comma-separated list to allow several origins: http://localhost:5173,https://app.example.com

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Encrypts stored Instagram/WhatsApp tokens. Changing it makes existing tokens unreadable.
ENCRYPTION_KEY=

# Public HTTPS base URL of this API; the single source for every OAuth redirect URI
# (Google, Microsoft, Instagram) and webhook URL.
PUBLIC_URL=
# Where the browser returns after an OAuth connect flow (the Next.js app).
FRONTEND_URL=http://localhost:5173

COOKIE_SECURE=
COOKIE_SAMESITE=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=

GEMINI_API_KEY=

AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Leave unset against real AWS S3; set only for an S3-compatible local server (e.g. MinIO).
AWS_S3_ENDPOINT_URL=

EmailSettings__Smtp__Host=smtp.gmail.com
EmailSettings__Smtp__Port=587
EmailSettings__Credentials__Username=
EmailSettings__Credentials__Password=
EmailSettings__Sender__Email=
EmailSettings__Sender__Name=Busines_Os Service
